# =============================================================================
# WrestlingDB Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Django Settings
# -----------------------------------------------------------------------------
APP_ENV=development
# Set to 'production' for production deployment

APP_SECRET_KEY=your-super-secret-key-change-in-production
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# Additional allowed hosts (comma-separated)
# EXTRA_ALLOWED_HOSTS=myserver.local,10.0.0.1

# -----------------------------------------------------------------------------
# Database Settings
# -----------------------------------------------------------------------------
# DB_ENGINE=postgres
# Optional. Defaults to SQLite. Set to "postgres" to use the PostgreSQL
# settings below instead of the local db.sqlite3 file.

# PostgreSQL (only read when DB_ENGINE=postgres)
DB_NAME=owdb
DB_USER=owdb
DB_PASSWORD=your-secure-database-password
DB_HOST=db
DB_PORT=5432

# For local development with SQLite, leave APP_ENV=development
# The app will automatically use SQLite

# SQLITE_PATH=/app/data/db.sqlite3
# Optional. Where the SQLite file lives when DB_ENGINE is unset/sqlite.
# Defaults to db.sqlite3 in the repo root. Point this at a writable,
# bind-mounted directory in Docker deployments (the container image itself
# is read-only for the app user).

# -----------------------------------------------------------------------------
# Redis Settings
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Celery Settings
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
DJANGO_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Scraper Configuration
# -----------------------------------------------------------------------------
# SCRAPER_ENABLED=true
# Optional. Master on/off switch for all data scrapers (Wikipedia, Cagematch,
# etc). Defaults to true; set to false to disable scraping entirely.

# -----------------------------------------------------------------------------
# External API Keys (all optional - free tiers available)
# -----------------------------------------------------------------------------

# TMDB - The Movie Database (free, requires signup)
# Get key at: https://www.themoviedb.org/settings/api
# TMDB_API_KEY=your-tmdb-api-key

# RAWG - Video Game Database (free tier: 20,000 requests/month)
# Get key at: https://rawg.io/apidocs
# RAWG_API_KEY=your-rawg-api-key

# Google Books API (free tier: 1,000 requests/day)
# Get key at: https://console.cloud.google.com/apis/credentials
# GOOGLE_BOOKS_API_KEY=your-google-books-api-key

# Podcast Index (free, requires signup)
# Get keys at: https://api.podcastindex.org/
# PODCAST_INDEX_API_KEY=your-podcast-index-key
# PODCAST_INDEX_API_SECRET=your-podcast-index-secret

# IGDB - Internet Game Database (free via Twitch)
# Get credentials at: https://api-docs.igdb.com/#getting-started
# IGDB_CLIENT_ID=your-twitch-client-id
# IGDB_CLIENT_SECRET=your-twitch-client-secret

# Listen Notes (free tier: 300 requests/month)
# Get key at: https://www.listennotes.com/api/
# LISTEN_NOTES_API_KEY=your-listen-notes-api-key

# -----------------------------------------------------------------------------
# WrestleBot AI Enhancement (optional)
# -----------------------------------------------------------------------------
# Anthropic Claude API for AI-powered data enhancement
# Get key at: https://console.anthropic.com/
# ANTHROPIC_API_KEY=your-anthropic-api-key

# CLAUDE_CODE_OAUTH_TOKEN=your-claude-code-oauth-token
# Optional, preferred over ANTHROPIC_API_KEY when both are set. Reuses a
# Claude Code / Claude subscription instead of billing the API directly.

# BRAVE_SEARCH_API_KEY=your-brave-search-api-key
# Optional. Used by WrestleBot's web-search enrichment source.
# Get a key at: https://brave.com/search/api/

# TAVILY_API_KEY=your-tavily-api-key
# Optional. Used by WrestleBot's web-search enrichment source (alternative
# to Brave Search). Get a key at: https://tavily.com/

# DISCOGS_TOKEN=your-discogs-personal-access-token
# Optional. Used by WrestleBot to look up wrestler entrance-theme releases.
# Get a token at: https://www.discogs.com/settings/developers

# -----------------------------------------------------------------------------
# Cloudflare R2 Storage (for image caching and uploads)
# -----------------------------------------------------------------------------
# Create API tokens at: Cloudflare Dashboard > R2 > Manage R2 API Tokens
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=owdb-images
R2_ACCOUNT_ID=ab3678edc12d723ab959fb449b095bc6
R2_CUSTOM_DOMAIN=images.wrestlingdb.org

# -----------------------------------------------------------------------------
# Email Configuration (for user verification)
# -----------------------------------------------------------------------------
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=OWDB <noreply@wrestlingdb.org>

# SERVER_EMAIL=errors@wrestlingdb.org
# Optional. "From" address for Django's own 500-error admin emails. Distinct
# from DEFAULT_FROM_EMAIL, which is for user-facing mail like verification.

# -----------------------------------------------------------------------------
# Sentry (error + performance monitoring, optional in local dev)
# -----------------------------------------------------------------------------
# Get the DSN from: Sentry > rosenberg-digital org > owdb project > Settings > Client Keys (DSN)
# Leave unset locally — Sentry stays disabled with no DSN configured.
# SENTRY_DSN=https://xxxxx@oXXXXXXX.ingest.us.sentry.io/XXXXXXX
# SENTRY_TRACES_SAMPLE_RATE=0.2
# SENTRY_PROFILES_SAMPLE_RATE=0.2
# SENTRY_RELEASE=
